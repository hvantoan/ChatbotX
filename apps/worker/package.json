    "build": "tsdown",
    "check-types": "NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit",
    "dev": "pnpm worker:core | pino-pretty",
    "https": "pnpm dev",
    "test": "vitest run --passWithNoTests",
    "test:domains": "tsx scripts/test-domains.ts",
    "test:watch": "vitest",
    "worker:schedule": "dotenv -e ../../.env -- tsx --watch src/schedule/worker.ts",
