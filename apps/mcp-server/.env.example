# ─── Production reference (app.chatbotx.io/mcp) ─────────────────────────────
# The load balancer forwards the complete /mcp/ prefix to this server without
# stripping it. Endpoint events and OAuth bearer challenges embed this path.
INBOXOS_API_URL=https://app.chatbotx.io/api
# Keep empty for a shared HTTP deployment. This stdio-only fallback would
# otherwise authorize every unauthenticated HTTP request with the server token.
INBOXOS_API_KEY=
INBOXOS_MCP_TRANSPORT=sse
INBOXOS_MCP_HOST=0.0.0.0
INBOXOS_MCP_PORT=3333
INBOXOS_MCP_MESSAGES_PATH=/mcp/messages
INBOXOS_MCP_SSE_PATH=/mcp/sse
# "*" is required for ChatGPT and browser clients; rely on OAuth rather than CORS.
INBOXOS_MCP_CORS_ORIGIN=*
INBOXOS_MCP_OAUTH_ENABLED=true
# Public builder origin. Leaving it unset can advertise an internal HTTP host.
INBOXOS_MCP_PUBLIC_URL=https://app.chatbotx.io
# INBOXOS_ALLOW_SELF_SIGNED_CERT=false
# INBOXOS_MCP_OAUTH_ISSUER=https://app.chatbotx.io
# INBOXOS_MCP_SERVER_NAME=inboxos-mcp
# INBOXOS_MCP_SERVER_INSTRUCTIONS=
# INBOXOS_SPEC_TTL_MS=300000
# INBOXOS_HTTP_TIMEOUT_MS=30000
# Used by @inboxos.io/logger.
LOG_LEVEL=info
