# Telegram bot token (từ @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat ID nhận alert (gửi /start cho bot rồi lấy từ api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=

# Beszel: lấy trong UI sau khi Add System (chỉ cần cho profile "agent")
BESZEL_KEY=
BESZEL_TOKEN=

# Network của stack ChatbotX (prod mặc định). Dev: chatbotx_chatbotx-network
CHATBOTX_NETWORK=chatbotx-prod_chatbotx-network

# Port (chỉ bind 127.0.0.1). Dozzle dùng 8088 vì 8080 đã là Adminer.
BESZEL_PORT=8090
DOZZLE_PORT=8088
# Dozzle bắt buộc đăng nhập (simple auth) — tạo file users trước khi up (xem README §2):
#   read -s -p 'Dozzle admin password: ' DOZZLE_ADMIN_PW
#   mkdir -p dozzle && docker run --rm -e DOZZLE_ADMIN_PW amir20/dozzle:v11.5.0 generate admin --password "$DOZZLE_ADMIN_PW" > dozzle/users.yml && unset DOZZLE_ADMIN_PW
GATUS_PORT=8081
GATUS_LOG_LEVEL=WARN
